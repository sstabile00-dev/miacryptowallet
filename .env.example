# Arbitrum Sepolia Testnet (for development)
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Arbitrum Mainnet (for production)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Your wallet private key (NEVER commit .env)
PRIVATE_KEY=your_private_key_here

# Fee recipient address (where your earnings go)
FEE_RECIPIENT=0x...

# Contract address (will be populated after deployment)
CONTRACT_ADDRESS=0x...

# Arbiscan API key for verification
ARBISCAN_API_KEY=your_api_key

# Backend server
PORT=3000
